# ============================================================
# cronjob-manager — Environment Configuration
# All app config env vars use the CRONJOB_MANAGER_ prefix so they never
# collide with docker-stack-template's own env vars.
# Every JSON-shaped ENV is parsed with base64 → raw fallback,
# so you can paste raw JSON in dev or base64 in prod/CI safely.
# ============================================================

# --- Server ---
# PORT = runtime listen port (Node/entrypoint convention, NOT prefixed).
# In the stack, entrypoint.sh derives it from CRONJOB_MANAGER_BACKEND_PORT.
PORT=8080
CRONJOB_MANAGER_LOG_LEVEL=info               # trace | debug | info | warn | error
CRONJOB_MANAGER_LOG_FORMAT=json              # json | pretty

# --- Auth between frontend & backend (REQUIRED) ---
CRONJOB_MANAGER_API_SECRET=change-me-super-secret   # required for every /api call (header x-api-secret)
CRONJOB_MANAGER_TINYAUTH_ENABLED=true
CRONJOB_MANAGER_TINYAUTH_USERS={"admin":"admin-pass"}  # JSON (base64-able)

# --- Firebase RTDB (choose ONE auth mode) ---
# For local/dev/demo without Firebase credentials, set RTDB_MODE=memory
CRONJOB_MANAGER_RTDB_MODE=                    # "memory" = in-process store (no Firebase needed)
CRONJOB_MANAGER_FIREBASE_DB_URL=https://your-db.firebaseio.com
# Mode A: legacy DB auth secret
CRONJOB_MANAGER_FIREBASE_AUTH_SECRET=
# Mode B (preferred if set): service account credentials JSON / base64 / path
CRONJOB_MANAGER_FIREBASE_SERVICE_ACCOUNT=
CRONJOB_MANAGER_RTDB_EXEC_QUEUE_PATH=/exec-queue

# --- cronjob.org ---
CRONJOB_MANAGER_CRONJOB_API_BASE=https://api.cron-job.org
# Per-account API keys live in RTDB /accounts — never hardcode here.

# --- Executor ---
CRONJOB_MANAGER_EXEC_HANDLERS_DIR=./handlers
CRONJOB_MANAGER_EXEC_ALLOWED=[]              # whitelist handler names; [] = allow all files in dir
CRONJOB_MANAGER_EXEC_TIMEOUT_MS=30000
CRONJOB_MANAGER_EXEC_CONCURRENCY=3
CRONJOB_MANAGER_EXEC_LOG_PAYLOAD=false       # beware secrets in payloads

# --- Optional at-rest secret encryption ---
CRONJOB_MANAGER_SECRET_ENCRYPTION_KEY=       # if set, tokens/PATs are AES-256-GCM encrypted in RTDB
